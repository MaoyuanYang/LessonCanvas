# LessonCanvas deployed-stack environment (F012 D1/D2). Copy to infra/deploy.env
# and fill real values. deploy.env is git-ignored; never commit real credentials.

# Infrastructure passwords (also used by the postgres/minio services).
LESSONCANVAS_DB_PASSWORD=
LESSONCANVAS_MINIO_PASSWORD=

# LAN origin wiring (F012 D2). Use this machine's LAN IP, not localhost.
# LESSONCANVAS_WEB_API_BASE_URL is baked into the web build (rebuild on change).
LESSONCANVAS_WEB_API_BASE_URL=http://<lan-ip>:8000
# CORS origins the API allows; JSON list (pydantic-settings parses complex types as JSON).
LESSONCANVAS_CORS_ALLOWED_ORIGINS=["http://<lan-ip>:3000"]

# Model provider (single adapter).
LESSONCANVAS_DEEPSEEK_API_KEY=
